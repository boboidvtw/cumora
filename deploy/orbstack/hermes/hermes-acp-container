#!/bin/sh
# ACP endpoint for a Hermes agent, running inside a container.
#
# Cumora's hermes adapter spawns this script and speaks ACP to it over stdio;
# the script is just a pipe into `hermes-acp` in the container, so the engine
# process never runs on the host. Point the daemon at it with
# CUMORA_HERMES_ACP_BIN=<this file>.
#
# What the container can reach, and nothing else:
#   - this agent's home            (its AGENTS.md, skills, notes — the ACP cwd)
#   - this agent's IPC directory   (how the `cumora` shim reaches the daemon)
#   - its own /opt/data volume     (Hermes state, one per agent)
#   - the host's LM Studio         (the model; see config.yaml below)
# Not the rest of the Mac, not ~/.cumora/computer.json (the device token), not
# the operator's own ~/.hermes credentials.
#
# stdout is the JSON-RPC channel: nothing here may print to it. The image's
# usual entrypoint runs an s6 supervision tree that logs to stdout, so we
# bypass it and exec hermes-acp directly — its own logs go to stderr, which
# the daemon captures.
set -eu

image=${CUMORA_HERMES_IMAGE:-nousresearch/hermes-agent:latest}
model=${CUMORA_HERMES_MODEL:-qwen3.8-27b}
model_base_url=${CUMORA_HERMES_BASE_URL:-http://host.docker.internal:1234/v1}
context_length=${CUMORA_HERMES_CONTEXT:-65536}
# One local model serves every call, one at a time, at ~12 tokens/s. Thinking
# ("reasoning") was 1-3k tokens per tool hop — minutes each — so it is off by
# default; CUMORA_HERMES_REASONING=low|medium|high turns it back on.
# Title generation and the smart-approval guardian are extra calls on that same
# model: titles are never shown (Cumora has its own conversation names) and
# approval is Cumora's container boundary, not a second model's opinion.
reasoning=${CUMORA_HERMES_REASONING:-none}

# The daemon's engine-inventory rescan asks for a version; answer from the
# image, which is what actually runs, without touching any agent's state.
if [ "${1:-}" = "--version" ] || [ "${1:-}" = "version" ]; then
  exec docker run --rm --entrypoint /opt/hermes/.venv/bin/hermes "$image" --version
fi

# A wake runs with CUMORA_AGENT_ID and CUMORA_AGENT_IPC_DIR set and the agent's
# home as cwd. `cumora agent computer doctor` probes have neither, so they get a
# shared throwaway identity and no IPC mount — a probe never posts anything.
agent_id=${CUMORA_AGENT_ID:-probe}
ipc_dir=${CUMORA_AGENT_IPC_DIR:-}
case "$agent_id" in
  *[!A-Za-z0-9_.-]*|'') echo "hermes-acp-container: unusable agent id '$agent_id'" >&2; exit 64 ;;
esac

# The daemon spawns us with cwd = the agent's home (or a scratch dir for
# triage), which is not always ~/.cumora/agents/<id>; mount what we were given.
home_dir=$(pwd -P)
case "$home_dir" in
  "$HOME"|/|/Users|/home) echo "hermes-acp-container: refusing to mount $home_dir as the agent home" >&2; exit 64 ;;
esac
# Optional mounts ride the positional parameters so a path with spaces stays
# one argument.
set --
if [ -n "$ipc_dir" ]; then
  mkdir -p "$ipc_dir"
  set -- -v "$ipc_dir:$ipc_dir"
fi
volume="cumora-hermes-$agent_id"

# Bump when the defaults written below change, and add the new keys to
# MIGRATE_DEFAULTS so volumes created before the change pick them up.
config_version=1

# First run for this agent: create its volume and write the Hermes config that
# points at the host's LM Studio. Kept out of the image so the model can be
# changed without a rebuild, and out of the agent home so the model config is
# not something the agent itself can rewrite mid-turn.
if docker volume inspect "$volume" >/dev/null 2>&1; then
  # Existing volume: fill in defaults added since it was created. Only keys
  # that are missing are written, so anything set by hand is kept, and a
  # version marker in the volume makes this run once per volume per version —
  # a key deleted on purpose afterwards stays deleted. ruamel keeps comments.
  # Everything goes to stderr (the daemon log); stdout is the JSON-RPC channel.
  # CUMORA_HERMES_MIGRATE=0 skips it.
  if [ "${CUMORA_HERMES_MIGRATE:-1}" != "0" ]; then
    docker run --rm -v "$volume:/opt/data" \
      -e "CONFIG_VERSION=$config_version" -e "REASONING=$reasoning" -e "VOLUME=$volume" \
      --entrypoint /opt/hermes/.venv/bin/python "$image" -c '
import os, sys
from ruamel.yaml import YAML
marker, path = "/opt/data/.cumora-config-version", "/opt/data/config.yaml"
want = int(os.environ["CONFIG_VERSION"])
try:
    have = int(open(marker).read().strip() or 0)
except (FileNotFoundError, ValueError):
    have = 0
if have >= want or not os.path.exists(path):
    sys.exit(0)
MIGRATE_DEFAULTS = [
    (("agent", "reasoning_effort"), os.environ["REASONING"]),
    (("auxiliary", "title_generation", "enabled"), False),
    (("approvals", "mode"), "off"),
]
yaml = YAML()
yaml.preserve_quotes = True
with open(path) as f:
    doc = yaml.load(f) or {}
added = []
for keys, value in MIGRATE_DEFAULTS:
    node = doc
    for k in keys[:-1]:
        if not isinstance(node.get(k), dict):
            node[k] = {}
        node = node[k]
    if keys[-1] not in node:
        node[keys[-1]] = value
        added.append(".".join(keys) + "=" + repr(value))
if added:
    with open(path, "w") as f:
        yaml.dump(doc, f)
    os.chown(path, 10000, 10000)
with open(marker, "w") as f:
    f.write(str(want) + "\n")
os.chown(marker, 10000, 10000)
volume = os.environ["VOLUME"]
result = "added " + ", ".join(added) if added else "nothing to add"
print(f"hermes-acp-container: {volume} config v{have} -> v{want}: {result}", file=sys.stderr)
' >&2 || echo "hermes-acp-container: config migration for $volume failed; starting with the existing config" >&2
  fi
else
  docker volume create "$volume" >/dev/null
  printf '%s\n' \
    "# Written by hermes-acp-container. Model runs on the host in LM Studio." \
    "model:" \
    "  default: $model" \
    "  provider: lmstudio" \
    "  base_url: $model_base_url" \
    "  context_length: $context_length" \
    "agent:" \
    "  reasoning_effort: $reasoning" \
    "auxiliary:" \
    "  title_generation:" \
    "    enabled: false" \
    "approvals:" \
    "  mode: \"off\"" \
    "database:" \
    "  journal_mode: wal" \
  | docker run --rm -i -v "$volume:/opt/data" --entrypoint /bin/sh "$image" \
      -c "cat > /opt/data/config.yaml && echo $config_version > /opt/data/.cumora-config-version && chown 10000:10000 /opt/data/config.yaml /opt/data/.cumora-config-version" >/dev/null
fi

exec docker run --rm -i \
  --entrypoint /opt/hermes/.venv/bin/hermes-acp \
  --name "cumora-hermes-$agent_id-$$" \
  -v "$volume:/opt/data" \
  -v "$home_dir:$home_dir" \
  "$@" \
  -w "$home_dir" \
  -e "CUMORA_AGENT_ID=$agent_id" \
  -e "CUMORA_AGENT_IPC_DIR=$ipc_dir" \
  -e "PATH=$home_dir/bin:/opt/hermes/bin:/opt/hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin" \
  -e HERMES_ACCEPT_HOOKS=1 \
  -e "HERMES_WRITE_SAFE_ROOT=/opt/data:$home_dir" \
  "$image"
