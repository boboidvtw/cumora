# Cumora 自架設定（OrbStack / Docker Compose）
#
# 複製成 .env 後填寫：cp .env.example .env
# .env 已被 .gitignore 排除，不會進版控。./up.sh 會自動產生下面兩個密鑰。

# ── 必填：GitHub OAuth App（登入用）──────────────────────────────────
# 在 https://github.com/settings/applications/new 建立：
#   Homepage URL:               http://localhost:5181
#   Authorization callback URL: http://localhost:5181/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 管理員（可進入 /admin 後台）；填你登入 GitHub 所用的 email，可逗號分隔多個。
CUMORA_ADMIN_EMAILS=

# ── 自動產生（./up.sh 第一次執行時填入，之後不要改）──────────────────
POSTGRES_PASSWORD=
AGENT_RUNTIME_SECRET=

# ── 選填 ─────────────────────────────────────────────────────────────
# 伺服器啟動需要這個變數有值。只用本機 Claude Code / Codex（BYOA）時放佔位值即可；
# 填真的 OpenAI key 才能用 AI 頭像生成等雲端功能。
OPENAI_API_KEY=sk-not-configured

# 對外網址與埠號。只在本機用就維持預設；改了要同步改 GitHub OAuth App 的網址。
# CUMORA_PUBLIC_ORIGIN=http://localhost:5181
# CUMORA_PORT=5181

# 首次開啟的介面語言（使用者之後仍可在設定裡切換）：zh-TW / zh-CN / en
# CUMORA_DEFAULT_LOCALE=zh-TW
